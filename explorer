            RestoreButton.Size = UDim2.new(0, 40, 0, 40)
            RestoreButton.Position = UDim2.new(1, -50, 0.5, -20)
            RestoreButton.BackgroundColor3 = Color3.fromRGB(17, 17, 23)
            RestoreButton.Text = "🔍"
            RestoreButton.TextColor3 = Color3.fromRGB(240, 240, 245)
            RestoreButton.Font = Enum.Font.GothamBold
            RestoreButton.TextSize = 18
            RestoreButton.BorderSizePixel = 0
            RestoreButton.Parent = ScreenGui
            
            local RestoreCorner = Instance.new("UICorner")
            RestoreCorner.CornerRadius = UDim.new(0, 8)
            RestoreCorner.Parent = RestoreButton
            AddStroke(RestoreButton, Color3.fromRGB(99, 102, 241))
            
            RestoreButton.MouseButton1Click:Connect(function()
