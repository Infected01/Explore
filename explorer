    CodeLayout.SortOrder = Enum.SortOrder.LayoutOrder
    CodeLayout.Padding = UDim.new(0, 0)
    CodeLayout.Parent = CodeDisplay
    
    -- // Functions
    local function ClearScriptList()
        for _, child in pairs(ScriptList:GetChildren()) do
            if child:IsA("TextButton") or child:IsA("TextLabel") then
                child:Destroy()
            end
        end
    end
    
    local function AddScriptButton(script, count)
        local Button = Instance.new("TextButton")
        Button.Size = UDim2.new(1, -4, 0, 28)
        Button.BackgroundColor3 = Color3.fromRGB(25, 25, 32)
        Button.TextColor3 = Color3.fromRGB(220, 220, 230)
        Button.Font = Enum.Font.GothamMedium
        Button.TextSize = 11
        Button.TextXAlignment = Enum.TextXAlignment.Left
        Button.BorderSizePixel = 0
        Button.Parent = ScriptList
        
        local Corner = Instance.new("UICorner")
        Corner.CornerRadius = UDim.new(0, 4)
        Corner.Parent = Button
        
        local Padding = Instance.new("UIPadding")
        Padding.PaddingLeft = UDim.new(0, 32) -- Push text to the right for the icon
        Padding.Parent = Button
        
        -- Decals (Dex Original Icons extracted mathematically)
        local IconLabel = Instance.new("ImageLabel")
        IconLabel.BackgroundTransparency = 1
        IconLabel.Position = UDim2.new(0, -24, 0.5, -8) 
        IconLabel.Size = UDim2.new(0, 16, 0, 16)
        
        SetDexIcon(IconLabel, script.ClassName)
        IconLabel.Parent = Button
        
        -- Show count if multiple
        local countText = ""
        if count and count > 1 then
            countText = " [" .. count .. "x]"
        end
        
        Button.Text = script.Name .. countText
        
        -- Copy Path Button
        local CopyPathBtn = Instance.new("TextButton")
        CopyPathBtn.Size = UDim2.new(0, 22, 0, 22)
        CopyPathBtn.Position = UDim2.new(1, -26, 0.5, -11)
        CopyPathBtn.BackgroundColor3 = Color3.fromRGB(45, 45, 55)
        CopyPathBtn.Text = "🔗"
        CopyPathBtn.TextColor3 = Color3.fromRGB(220, 220, 230)
        CopyPathBtn.Font = Enum.Font.Gotham
        CopyPathBtn.TextSize = 12
        CopyPathBtn.BorderSizePixel = 0
        CopyPathBtn.Parent = Button
        
        local PathCorner = Instance.new("UICorner")
        PathCorner.CornerRadius = UDim.new(0, 4)
        PathCorner.Parent = CopyPathBtn
        
        CopyPathBtn.MouseEnter:Connect(function()
            CopyPathBtn.BackgroundColor3 = Color3.fromRGB(65, 65, 75)
        end)
        
        CopyPathBtn.MouseLeave:Connect(function()
            CopyPathBtn.BackgroundColor3 = Color3.fromRGB(45, 45, 55)
        end)
        
        CopyPathBtn.MouseButton1Click:Connect(function()
            pcall(function()
                setclipboard(script:GetFullName())
            end)
            CopyPathBtn.Text = "✅"
            coroutine.wrap(function()
                task.wait(1)
                if CopyPathBtn then
                    CopyPathBtn.Text = "🔗"
                end
            end)()
        end)
        
        Button.MouseEnter:Connect(function()
            Button.BackgroundColor3 = Color3.fromRGB(35, 35, 45)
        end)
        
        Button.MouseLeave:Connect(function()
            Button.BackgroundColor3 = Color3.fromRGB(25, 25, 32)
        end)
        
        Button.MouseButton1Click:Connect(function()
            local rawDecompiled = Decompile(script)
            CurrentDecompiledScript = rawDecompiled -- Store exactly what is returned for copy functionality
            
            -- Fix Long Text & Color cutoff by using chunks
            for _, child in pairs(CodeDisplay:GetChildren()) do
                if child:IsA("TextLabel") then
                    child:Destroy()
                end
            end
            
            local safeCode = rawDecompiled:gsub("\r", "")
            local lines = string.split(safeCode, "\n")
            local chunkSize = 50
            for i = 1, #lines, chunkSize do
                local chunk = {}
                for j = 0, chunkSize - 1 do
                    if lines[i + j] then
                        table.insert(chunk, lines[i + j])
                    end
                end
                local chunkText = table.concat(chunk, "\n")
                
                local lbl = Instance.new("TextLabel")
                lbl.Name = "CodeChunk_" .. i
                lbl.Size = UDim2.new(0, 0, 0, 0)
                lbl.BackgroundTransparency = 1
                if #chunkText > 20000 then -- Prevent rich text crashing on massively minified single lines
                    lbl.Text = chunkText:gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;")
                else
                    lbl.Text = HighlightLua(chunkText)
                end
                lbl.TextColor3 = Color3.fromRGB(204, 204, 204)
                lbl.Font = Enum.Font.Code
                lbl.TextSize = 13 
                lbl.TextXAlignment = Enum.TextXAlignment.Left
                lbl.TextYAlignment = Enum.TextYAlignment.Top
                lbl.TextWrapped = false 
                lbl.RichText = true
                lbl.AutomaticSize = Enum.AutomaticSize.XY
                lbl.LayoutOrder = i
                lbl.Parent = CodeDisplay
            end

            DecompilePanel.Visible = true
            DecompilePanel.Position = UDim2.new(0, -550, 0.5, -190)
            local tweenInfo = TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
            local tween = TweenService:Create(DecompilePanel, tweenInfo, {Position = UDim2.new(0, 20, 0.5, -190)})
            tween:Play()
        end)
    end
    
    function RefreshList()
        ClearScriptList()
        local searchText = SearchInput.Text:lower()
        
        local scriptsFound = {}
        local scriptCounts = {}
        
        local locations = {
            game:GetService("Workspace"),
            game:GetService("ReplicatedStorage"),
            game:GetService("ServerScriptService"),
            game:GetService("ServerStorage"),
            game:GetService("StarterGui"),
            game:GetService("StarterPack"),
            game:GetService("StarterPlayer"),
            game:GetService("CoreGui"),
            game:GetService("Lighting"),
            game:GetService("SoundService"),
            game:GetService("Teams"),
            game:GetService("ReplicatedFirst"),
            game:GetService("Chat")
        }
        
        if Player:FindFirstChild("PlayerGui") then
            locations[#locations + 1] = Player.PlayerGui
        end
        if Player:FindFirstChild("PlayerScripts") then
            locations[#locations + 1] = Player.PlayerScripts
        end
        
        for _, location in pairs(locations) do
            pcall(function()
                for _, obj in pairs(location:GetDescendants()) do
                    local isScript = false
                    if obj.ClassName == "Script" and Filters.Script then isScript = true end
                    if obj.ClassName == "LocalScript" and Filters.LocalScript then isScript = true end
                    if obj.ClassName == "ModuleScript" and Filters.ModuleScript then isScript = true end
                    
                    if isScript and not IsDefaultScript(obj) then
                        local scriptName = obj.Name
                        if searchText == "" or scriptName:lower():find(searchText) then
                            if not scriptCounts[scriptName] then
                                scriptCounts[scriptName] = { count = 0, script = obj }
                            end
                            scriptCounts[scriptName].count += 1
                            table.insert(scriptsFound, obj)
                        end
                    end
                end
            end)
        end
        
        local uniqueScripts = {}
        for name, data in pairs(scriptCounts) do
            data.name = name
            table.insert(uniqueScripts, data)
        end
        
        table.sort(uniqueScripts, function(a, b)
            return a.name < b.name
        end)
        
        for _, data in pairs(uniqueScripts) do
            AddScriptButton(data.script, data.count)
        end
        
        local totalHeight = #uniqueScripts * 32
        ScriptList.CanvasSize = UDim2.new(0, 0, 0, totalHeight)
        ScriptCount.Text = "Scripts: " .. #uniqueScripts .. " unique (" .. #scriptsFound .. " total)"
        
        if #uniqueScripts == 0 then
            local NoScripts = Instance.new("TextLabel")
            NoScripts.Size = UDim2.new(1, -6, 0, 30)
            NoScripts.Position = UDim2.new(0, 3, 0, 5)
            NoScripts.BackgroundTransparency = 1
            NoScripts.Text = "No custom scripts found"
            NoScripts.TextColor3 = Color3.fromRGB(150, 150, 150)
            NoScripts.Font = Enum.Font.Gotham
            NoScripts.TextSize = 11
            NoScripts.Parent = ScriptList
        end
    end
    
    -- // Button Events
    CloseButton.MouseButton1Click:Connect(function()
        ScreenGui:Destroy()
    end)
    
    FilterButton.MouseButton1Click:Connect(function()
        FilterPanel.Visible = not FilterPanel.Visible
    end)
    
