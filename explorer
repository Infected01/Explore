local function IsDefaultScript(script)
    local name = script.Name
    local path = script:GetFullName()
    
    -- Block standard Roblox Core systems completely
    if path:find("CorePackages") or path:find("RobloxGui") or path:find("RobloxPromptGui") or path:find("RobloxNetwork") or path:find("CoreScripts") then
        return true
    end
    
    -- Block standard default modules
    if path:find("PlayerModule") or path:find("ChatModules") or path:find("ClientChatModules") or path:find("CameraScript") or path:find("ControlScript") then
        return true
    end

    -- Check exact name against defaults
    for _, defaultName in pairs(DefaultScripts) do
        if name == defaultName then
            return true
        end
    end
    
    -- Check for default Roblox generic scripts
    if script.ClassName == "LocalScript" and 
       (name == "LocalScript" or name == "Animate" or name == "Health") then
        -- Only ignore if they are in typical default locations
        if path:find("StarterCharacter") or path:find("StarterPlayer") or script.Parent:IsA("Character") then
            return true
        end
    end
    
    return false
end

-- // Syntax Highlighter (Exact Dex Explorer Colors)
local function HighlightLua(code)
    -- Fix HTML characters
    code = code:gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;")
    
    -- Special tags
    code = code:gsub('("[^"\n]*")', '※S※%1※E※')
    code = code:gsub("('[^'\n]*')", '※S※%1※E※')
    code = code:gsub("(%-%-[^\n]*)", '※C※%1※E※')
    
    -- Numbers (Sadece bağımsız sayılar, değişken içindekiler hariç)
    code = code:gsub("%f[%w_](%d+%.?%d*)%f[^%w_]", '※N※%1※E※')
    
    -- Keyword Lists (Imported from Dex table)
    local lua_keywords = {"and", "break", "or", "else", "elseif", "if", "then", "until", "repeat", "while", "do", "for", "in", "end", "return", "export", "not"}
    local rbx_keywords = {"game", "workspace", "script", "math", "string", "table", "task", "wait", "select", "next", "Enum", "error", "warn", "tick", "assert", "shared", "loadstring", "tonumber", "tostring", "type", "typeof", "unpack", "print", "Instance", "CFrame", "Vector3", "Vector2", "Color3", "UDim", "UDim2", "Ray", "BrickColor", "OverlapParams", "RaycastParams", "Axes", "Random", "Region3", "Rect", "TweenInfo", "collectgarbage", "utf8", "pcall", "xpcall", "_G", "setmetatable", "getmetatable", "os", "pairs", "ipairs"}
    local loc_func = {"local", "function", "self"}
    local bool_nil = {"true", "false", "nil"}
    
    -- Matching (Sınırları daraltıldı, değişken isimleri içindeki kelimeleri renklendirmez)
    for _, kw in pairs(lua_keywords) do code = code:gsub("%f[%w_]("..kw..")%f[^%w_]", '※L※%1※E※') end
    for _, kw in pairs(rbx_keywords) do code = code:gsub("%f[%w_]("..kw..")%f[^%w_]", '※R※%1※E※') end
    for _, kw in pairs(loc_func) do code = code:gsub("%f[%w_]("..kw..")%f[^%w_]", '※F※%1※E※') end
    for _, kw in pairs(bool_nil) do code = code:gsub("%f[%w_]("..kw..")%f[^%w_]", '※N※%1※E※') end
    
    -- Dex HEX Color Conversions
    code = code:gsub("※S※", '<font color="#ADF184">') -- String (Light Green)
    code = code:gsub("※C※", '<font color="#666666">') -- Comment (Gray)
    code = code:gsub("※N※", '<font color="#FFC600">') -- Number/Bool/Nil (Yellow/Orange)
    code = code:gsub("※L※", '<font color="#F86D7C">') -- Lua Keywords (if, then, end - Light Red)
    code = code:gsub("※R※", '<font color="#84D6F7">') -- Built-in (game, workspace - Light Blue)
    code = code:gsub("※F※", '<font color="#F86D73">') -- Local/Function (Pinkish Red)
    code = code:gsub("※E※", '</font>')
    
    return code
end

local function Decompile(script)
    local source = nil
    local executor = (identifyexecutor and identifyexecutor()) or (getexecutorname and getexecutorname()) or "Your executor"
    
    -- Try to get source for client-accessible scripts
    if script:IsA("LocalScript") or script:IsA("ModuleScript") then
        -- 1. Try exploit decompile function first (Krnl, Synapse, Fluxus, etc.)
        if type(decompile) == "function" then
            pcall(function()
                source = decompile(script)
            end)
        end
        
        -- 2. Fallback to script.Source if decompile fails or isn't available
        if not source or source == "" then
            pcall(function()
                source = script.Source
            end)
        end
        
        if source and source ~= "" then
            return "-- Script Path: " .. script:GetFullName() .. "\n\n" .. source
        else
            -- Exact Dex Explorer Error Message
            return ("-- DEX - %s failed to decompile %s"):format(executor, script.ClassName)
        end
    end
    
    return ("-- DEX - %s failed to decompile %s (Server Script / Inaccessible)"):format(executor, script.ClassName)
end

-- // Helper to add Strokes
local function AddStroke(parent, color)
    local stroke = Instance.new("UIStroke")
    stroke.Color = color
    stroke.Thickness = 1
    stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    stroke.Parent = parent
    return stroke
end

-- // Helper to Extract Exact Dex Icons (NewDark scheme)
local function SetDexIcon(obj, className)
    obj.Image = "rbxassetid://135148380892747"
    
    local icons = {
        LocalScript = 144,
        ModuleScript = 155,
        Script = 197
    }
    local index = (icons[className] or 197) - 1
    local iconSize = 32
    local height = 18
    
    local col = math.floor(index % height)
    local row = math.floor(index / height)
    
    local xOffset = col * iconSize
    local yOffset = row * iconSize
    
    obj.ImageRectOffset = Vector2.new(xOffset, yOffset)
    obj.ImageRectSize = Vector2.new(iconSize, iconSize)
end

