    end)
    
    DecompileCloseButton.MouseButton1Click:Connect(function()
        local tweenInfo = TweenInfo.new(0.2, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
        local tween = TweenService:Create(DecompilePanel, tweenInfo, {Position = UDim2.new(0, -550, 0.5, -190)})
        tween:Play()
        tween.Completed:Wait()
        DecompilePanel.Visible = false
    end)
    
    CopyButton.MouseButton1Click:Connect(function()
        if CurrentDecompiledScript ~= "" then
            pcall(function()
                setclipboard(CurrentDecompiledScript)
            end)
            
            CopyButton.Text = "✅"
            task.delay(1, function()
                if CopyButton then CopyButton.Text = "📋" end
            end)
        end
    end)
    
    RefreshButton.MouseButton1Click:Connect(function()
        RefreshList()
    end)
    
    SearchInput:GetPropertyChangedSignal("Text"):Connect(function()
        RefreshList()
    end)
    
    RefreshList()
end

CreateGUI()
